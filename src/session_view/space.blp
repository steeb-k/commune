using Gtk 4.0;
using Adw 1;

template $ContentSpace: Adw.Bin {
  vexpand: true;
  hexpand: true;

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar header_bar {
      [title]
      Adw.WindowTitle {
        title: bind template.room as <$Room>.display-name;
        // Translators: A space is a collection of rooms, presented as a
        // folder-like room that other rooms belong to.
        subtitle: _("Space");
      }
    }

    content: Gtk.ScrolledWindow {
      vexpand: true;
      hscrollbar-policy: never;

      child: Adw.Clamp {
        maximum-size: 444;
        tightening-threshold: 300;
        vexpand: true;
        margin-top: 24;
        margin-bottom: 24;
        margin-start: 24;
        margin-end: 24;

        child: Gtk.Box {
          valign: center;
          halign: center;
          spacing: 24;
          orientation: vertical;

          accessibility {
            label: _("Space");
          }

          $Avatar avatar {
            size: 150;
            data: bind template.room as <$Room>.avatar-data;
            watched-room: bind template.room;
            watched-safety-setting: "invite-avatars";
            accessible-role: "presentation";
          }

          Gtk.Box {
            orientation: vertical;

            Gtk.Label {
              wrap: true;
              wrap-mode: word_char;
              justify: center;
              label: bind template.room as <$Room>.display-name;

              styles [
                "title-1",
              ]
            }

            Gtk.Label room_alias {
              wrap: true;
              wrap-mode: word_char;
              justify: center;
              label: bind template.room as <$Room>.aliases as <$RoomAliases>.alias-string;
              visible: bind $string_not_empty(template.room as <$Room>.aliases as <$RoomAliases>.alias-string) as <bool>;

              styles [
                "dimmed",
              ]
            }
          }

          Gtk.Label room_topic {
            wrap: true;
            wrap-mode: word_char;
            justify: center;
            use-markup: true;
            label: bind template.room as <$Room>.topic-linkified;
            visible: bind $string_not_empty(template.room as <$Room>.topic-linkified) as <bool>;

            styles [
              "dimmed",
              "body",
            ]
          }

          Gtk.Label {
            wrap: true;
            wrap-mode: word_char;
            justify: center;
            label: _("A space groups rooms together. The rooms in this one cannot be listed here yet — open them from the sidebar, or find them with Explore.");

            styles [
              "dimmed",
              "body",
            ]
          }
        };
      };
    };
  }
}
