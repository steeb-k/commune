using Gtk 4.0;
using Adw 1;

template $ImagePacksSubpage: Adw.NavigationPage {
  title: _("Image Packs");

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [end]
      Gtk.Button create_button {
        icon-name: "list-add-symbolic";
        tooltip-text: _("Create Pack");
        visible: false;
        clicked => $create_pack() swapped;
      }
    }

    content: Gtk.Stack stack {
      Gtk.StackPage {
        name: "loading";

        child: Adw.Spinner {
          halign: center;
          valign: center;
          width-request: 32;
          height-request: 32;
        };
      }

      Gtk.StackPage {
        name: "empty";

        child: Adw.StatusPage {
          icon-name: "sticker-symbolic";
          title: _("No Image Packs");
          description: _("This room does not define any sticker or emoticon pack");

          child: Gtk.Button empty_create_button {
            label: _("_Create Pack");
            use-underline: true;
            visible: false;
            halign: center;
            clicked => $create_pack() swapped;

            styles [
              "pill",
              "suggested-action",
            ]
          };
        };
      }

      Gtk.StackPage {
        name: "packs";

        child: Adw.PreferencesPage {
          Adw.PreferencesGroup packs_group {
            description: _("The packs defined in this room. Enable one to use it in every room.");
          }
        };
      }
    };
  };
}
