using Gtk 4.0;
using Adw 1;

template $Avatar: Adw.Bin {
  notify::scale-factor => $update_scale_factor() swapped;

  // The overlay hugs the avatar rather than filling the space this widget was
  // given, so the badge lands on the avatar's own corner. Without this it goes
  // to the right edge of whatever container the avatar happens to sit in,
  // which on a profile page is a long way away.
  child: Gtk.Overlay {
    halign: center;
    valign: center;

    child: Adw.Avatar avatar {
      show-initials: true;
      text: bind template.data as <$AvatarData>.display-name;
    };

    // The badge saying whether the owner is around. Hidden unless the site
    // asked for it and the homeserver said something, so an avatar in a picker
    // or a room's avatar is unchanged.
    [overlay]
    Gtk.Image presence_badge {
      visible: false;
      halign: end;
      valign: end;
      icon-name: "dot-symbolic";
      accessible-role: presentation;

      styles [
        "presence-badge",
      ]
    }
  };
}
