using Gtk 4.0;
using Adw 1;

template $RoomPreviewDialog: $ToastableDialog {
  title: _("Join a Room");
  content-width: 480;
  content-height: 500;

  child-content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-title: false;

      [start]
      Gtk.Button go_back_btn {
        visible: false;
        icon-name: "go-previous-symbolic";
        clicked => $go_back() swapped;
        tooltip-text: _("Back");
      }
    }

    [top]
    Adw.Clamp {
      hexpand: true;

      child: Gtk.Box {
        orientation: vertical;
        spacing: 18;
        margin-start: 24;
        margin-end: 24;

        Gtk.Label heading {
          wrap: true;
          wrap-mode: word_char;
          max-width-chars: 20;
          justify: center;
          xalign: 0.5;
          label: _("Join a Room");

          styles [
            "title-2",
          ]
        }
      };
    }

    content: Gtk.Stack stack {
      Gtk.StackPage {
        name: "entry";

        child: Gtk.ScrolledWindow {
          hscrollbar-policy: never;
          propagate-natural-height: true;

          child: Adw.Clamp {
            margin-start: 24;
            margin-end: 24;

            child: Gtk.Box entry_page {
              orientation: vertical;
              valign: center;
              spacing: 24;

              Gtk.Label look_up_instructions {
                wrap: true;
                wrap-mode: word_char;
                justify: center;
                use-markup: true;
                label: _("Enter an address or link to look up a room");

                styles [
                  "body",
                ]
              }

              Gtk.SearchEntry search_entry {
                accessibility {
                  described-by: [
                    look_up_instructions,
                  ];
                }

                search-changed => $update_entry_page() swapped;
                activate => $look_up_room() swapped;
              }

              $LoadingButton look_up_btn {
                // Translators: This is a verb, as in 'Look up Room'.
                content-label: _("Look Up");
                halign: center;
                clicked => $look_up_room() swapped;

                styles [
                  "suggested-action",
                  "standalone-button",
                  "pill",
                ]
              }
            };
          };
        };
      }

      Gtk.StackPage {
        name: "loading";

        child: Adw.Spinner {};
      }

      Gtk.StackPage {
        name: "details";

        child: Gtk.ScrolledWindow {
          child: Adw.Clamp {
            margin-start: 24;
            margin-end: 24;

            child: Gtk.Box {
              orientation: vertical;
              valign: center;
              spacing: 12;

              $Avatar room_avatar {
                size: 128;
                accessible-role: presentation;
              }

              Gtk.Label room_name {
                wrap: true;
                wrap-mode: word_char;
                justify: center;

                styles [
                  "title-3",
                ]
              }

              Gtk.Label room_alias {
                wrap: true;
                wrap-mode: word_char;
                justify: center;

                styles [
                  "dimmed",
                ]
              }

              Gtk.Label room_topic {
                wrap: true;
                wrap-mode: word_char;
                justify: center;
                use-markup: true;
                selectable: true;

                styles [
                  "body",
                ]
              }

              Gtk.Box room_members_box {
                halign: center;
                spacing: 6;

                Gtk.Image {
                  icon-name: "users-symbolic";
                  accessible-role: presentation;

                  styles [
                    "dimmed",
                  ]
                }

                Gtk.Label room_members_count {
                  styles [
                    "dimmed",
                  ]
                }
              }

              Gtk.Box {
                margin-top: 12;
                halign: center;
                spacing: 12;

                Gtk.Button peek_btn {
                  visible: false;
                  // Translators: This is a verb, as in 'Preview Room'. It
                  // opens the last messages of a room that can be read
                  // without joining it.
                  label: _("Preview");
                  clicked => $peek_room() swapped;

                  styles [
                    "standalone-button",
                    "pill",
                  ]
                }

                $LoadingButton view_or_join_btn {
                  clicked => $view_or_join_room() swapped;

                  styles [
                    "suggested-action",
                    "standalone-button",
                    "pill",
                  ]
                }
              }
            };
          };
        };
      }

      Gtk.StackPage {
        name: "peek";

        child: Gtk.Box {
          orientation: vertical;
          spacing: 12;

          Gtk.Label {
            wrap: true;
            wrap-mode: word_char;
            justify: center;
            margin-start: 24;
            margin-end: 24;
            label: _("Anybody can read this room without joining it. Nobody in it can see that you are looking.");

            styles [
              "dimmed",
              "caption",
            ]
          }

          Gtk.Stack peek_stack {
            transition-type: crossfade;
            vexpand: true;

            Gtk.StackPage {
              name: "loading";

              child: Adw.Spinner {};
            }

            Gtk.StackPage {
              name: "empty";

              child: Adw.StatusPage {
                icon-name: "chat-bubbles-text-symbolic";
                title: _("Nothing to Read");
                description: _("There are no messages in this room yet.");
              };
            }

            Gtk.StackPage {
              name: "error";

              child: Adw.StatusPage {
                icon-name: "error-symbolic";
                title: _("Cannot Be Read");
                description: _("This room cannot be read without joining it after all. Its homeserver may not allow it, or this homeserver may not know the room.");
              };
            }

            Gtk.StackPage {
              name: "list";

              child: Gtk.ScrolledWindow {
                hscrollbar-policy: never;
                vexpand: true;

                child: Adw.Clamp {
                  margin-start: 24;
                  margin-end: 24;
                  margin-bottom: 12;

                  child: Gtk.ListBox peek_list {
                    selection-mode: none;

                    styles [
                      "boxed-list",
                      "room-peek",
                    ]
                  };
                };
              };
            }
          }

          $LoadingButton peek_view_or_join_btn {
            margin-bottom: 12;
            halign: center;
            clicked => $view_or_join_room() swapped;

            styles [
              "suggested-action",
              "standalone-button",
              "pill",
            ]
          }
        };
      }
    };
  };
}
