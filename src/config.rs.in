use crate::application::AppProfile;

pub(crate) const APP_ID: &str = @APP_ID@;
/// The number of commits behind this build, which is what orders two builds
/// that carry the same [`VERSION`]. See `meson.build`.
pub(crate) const BUILD_NUMBER: u64 = @BUILD_NUMBER@;
/// Only the glycin image decoder has a sandbox, and glycin is only used on
/// Linux, so this is dead code anywhere else.
#[cfg(target_os = "linux")]
pub(crate) const DISABLE_GLYCIN_SANDBOX: bool = @DISABLE_GLYCIN_SANDBOX@;
pub(crate) const GETTEXT_PACKAGE: &str = @GETTEXT_PACKAGE@;
pub(crate) const KLIPY_API_KEY: &str = @KLIPY_API_KEY@;
pub(crate) const LOCALEDIR: &str = @LOCALEDIR@;
pub(crate) const PROFILE: AppProfile = AppProfile::@PROFILE@;
pub(crate) const RESOURCES_FILE: &str = concat!(@PKGDATADIR@, "/resources.gresource");
pub(crate) const UI_RESOURCES_FILE: &str = concat!(@PKGDATADIR@, "/ui-resources.gresource");
pub(crate) const VERSION: &str = @VERSION@;

#[cfg(test)]
pub(crate) mod tests {
    pub(crate) const BUILD_DIR: &str = @BUILD_DIR@;
}
