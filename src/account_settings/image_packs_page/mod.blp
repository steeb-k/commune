using Gtk 4.0;
using Adw 1;

template $ImagePacksPage: Adw.PreferencesPage {
  icon-name: "sticker-symbolic";
  title: _("Image Packs");
  name: "image-packs";

  Adw.PreferencesGroup packs_group {
    title: _("Packs");
    description: _("The sticker and emoticon packs defined in the rooms you are in. Turn one on to use it in every room.");

    header-suffix: $LoadingButton create_button {
      content-icon-name: "list-add-symbolic";
      tooltip-text: _("Create Pack");
      valign: center;
      clicked => $create_pack() swapped;

      styles [
        "flat",
      ]
    };

    Adw.ActionRow placeholder_row {
      title: _("No Packs");
      subtitle: _("Create one to send stickers and emoticons of your own");
      selectable: false;
      activatable: false;

      styles [
        "dimmed",
      ]
    }
  }

  Adw.PreferencesGroup unavailable_group {
    visible: false;
    title: _("Unavailable");
    description: _("These packs are used in every room but come from rooms you have left. Turn one off to stop looking for it.");
  }
}
