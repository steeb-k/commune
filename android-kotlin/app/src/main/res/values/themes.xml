<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The activity theme; the v31 overlays add the splash attributes.
         The window is light, so the status and navigation bar icons must
         be dark; the night variant leaves them light. -->
    <style name="Theme.Commune.Starting" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
