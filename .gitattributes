# Keep the working tree on Unix newlines everywhere, whatever a developer's
# global `core.autocrlf` says. `.rustfmt.toml` sets `newline_style = "Unix"`, so
# a checkout with CRLF fails the formatting check on every file in the tree —
# which is what a Windows checkout does by default. Binary files are detected
# and left alone by `text=auto`.
* text=auto eol=lf

build-aux/io.github.steeb_k.Commune.Devel.json export-ignore
build-aux/io.github.steeb_k.Commune.json export-ignore
.editorconfig export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.gitlab export-ignore
.gitlab-ci.yml export-ignore
hooks export-ignore
.rustfmt.toml export-ignore
.typos.toml export-ignore

# A POSIX shell will not run a script with CRLF line endings: the shebang comes
# out as `bash\r`, and the error names that rather than the script, so it reads
# as a missing interpreter instead of a mangled file.
#
# This rule was `build-aux/android/*.sh`, which was too narrow. The Android
# build runs Meson against this Windows checkout, and
# `build-aux/compile-blueprints.sh` — which every platform's build calls — came
# out with CRLF and stopped the build 2654 targets in. None of these are ever
# run by a Windows shell, so all of them can simply be LF.
*.sh text eol=lf
