# Keep the working tree on Unix newlines everywhere, whatever a developer's
# global `core.autocrlf` says. `.rustfmt.toml` sets `newline_style = "Unix"`, so
# a checkout with CRLF fails the formatting check on every file in the tree —
# which is what a Windows checkout does by default. Binary files are detected
# and left alone by `text=auto`.
* text=auto eol=lf

build-aux/io.github.steeb_k.Commune.Devel.json export-ignore
